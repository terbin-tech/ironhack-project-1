# Generated by infra/main (terraform apply). Do not edit by hand.

Host bastion-instance-1
  HostName ${bastion_ip}

Host frontend-instance-1
  HostName ${frontend_ip}
  ProxyJump bastion-instance-1

Host backend-instance-1
  HostName ${backend_ip}
  ProxyJump bastion-instance-1

Host db-instance-1
  HostName ${db_ip}
  ProxyJump bastion-instance-1

Host *
  User ubuntu
  IdentityFile ${identity_file}
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ${known_hosts}
