# Generated by infra/main (terraform apply). Do not edit by hand.

Host bastion-instance-1
  HostName ${bastion_ip}

Host backend-instance-1
  HostName ${backend_ip}
  ProxyJump bastion-instance-1

Host db-instance-1
  HostName ${db_ip}
  ProxyJump bastion-instance-1

# vote and result instances come and go with their Auto Scaling groups; reach
# one by its private IP: ssh -F ansible/ssh_config 10.0.11.23
Host 10.0.11.* 10.0.12.*
  ProxyJump bastion-instance-1

Host *
  User ubuntu
  IdentityFile ${identity_file}
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ${known_hosts}
